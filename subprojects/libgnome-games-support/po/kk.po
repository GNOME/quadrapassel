#: games/appearance-group.vala:144
msgid "Appearance"
msgstr "Сыртқы көрініс"

#. Empty State
#: games/scores/dialog.vala:83
msgid "No scores yet"
msgstr "Ұпай саны әлі жоқ"

#: games/scores/dialog.vala:88
msgid "Play some games and your scores will show up here."
msgstr "Кейбір ойындарды ойнаңыз, ұпайларыңыз осында көрсетіледі."

#: games/scores/dialog.vala:97
msgid "Clear Scores…"
msgstr "Ұпайларды тазарту…"

#. Translators: %1$s is the category type, %2$s is the category (e.g. "New
#. Score for Level: 1")
#: games/scores/dialog.vala:118
#, c-format
msgid "New Score for %1$s: %2$s"
msgstr "%1$s үшін жаңа ұпай: %2$s"

#: games/scores/dialog.vala:119
msgid "Score"
msgstr "Ұпай саны"

#. Translators: %1$s is the category type, %2$s is the category (e.g. "New
#. Time for Level: 1")
#: games/scores/dialog.vala:124
#, c-format
msgid "New Time for %1$s: %2$s"
msgstr "%1$s үшін жаңа уақыт: %2$s"

#: games/scores/dialog.vala:125
msgid "Time"
msgstr "Уақыт"

#: games/scores/dialog.vala:134
msgid "Congratulations!"
msgstr "Құттықтаймыз!"

#. Translators: %1$s is the category type, %2$s is the category (e.g. "Level:
#. 1")
#: games/scores/dialog.vala:141 games/scores/dialog.vala:209
#, c-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#: games/scores/dialog.vala:387
msgid "Player"
msgstr "Ойыншы"

#: games/scores/dialog.vala:393
msgid "_New Game"
msgstr "_Жаңа ойын"

#: games/scores/dialog.vala:404
msgid "_Quit"
msgstr "_Шығу"

#: games/scores/dialog.vala:436
msgid "Clear All Scores?"
msgstr "Барлық ұпайларды тазарту керек пе?"

#: games/scores/dialog.vala:437
msgid "This will clear every score for every layout."
msgstr "Бұл әр жайма үшін әрбір ұпайды тазартады."

#: games/scores/dialog.vala:440
msgid "_Cancel"
msgstr "_Бас тарту"

#: games/scores/dialog.vala:441
msgid "Clear All"
msgstr "Барлығын тазарту"

