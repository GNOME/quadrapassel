using Gtk 4.0;

template $AdaptiveCard: Gtk.Box {
  accessible-role: list_item;
  focusable: true;
  spacing: 3;
  orientation: vertical;
  vexpand: true;

  styles [
    "focusable-card",
    "card",
    "padding",
  ]

  accessibility {
    labelled-by: info_type;
    described-by: info;
  }

  Gtk.Label info_type {
    halign: center;
    valign: start;
    ellipsize: end;

    styles [
      "dimmed",
    ]
  }

  Gtk.Label info {
    margin-bottom: 2;
    halign: center;
    vexpand: true;

    styles [
      "title-4",
    ]
  }
}
