using Gtk 4.0;

template $AdaptiveCard: Gtk.Box  {
  accessible-role: list_item;
  focusable: true;
  spacing: 3;
  orientation: vertical;
  valign: center;

  styles [
    "focusable-card",
  ]

  accessibility {
    labelled-by: info_type;
    described-by: info;
  }

  Gtk.Label info {
    halign: center;

    styles [
      "title-2",
    ]
  }

  Gtk.Label info_type {
    halign: center;
    ellipsize: end;

    styles [
      "caption-heading",
    ]
  }
}
