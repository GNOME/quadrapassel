using Gtk 4.0;
using Adw 1;

template $AdaptiveCard: Adw.Bin {
  accessible-role: list_item;
  focusable: true;

  styles [
    "focusable-card",
  ]

  accessibility {
    labelled-by: info_type;
    described-by: info;
  }

  Gtk.Box box {
    spacing: 3;
    orientation: vertical;
    vexpand: true;
    valign: center;

    Gtk.Label info {
      halign: center;

      styles [
        "title-2",
      ]
    }

    Gtk.Label info_type {
      halign: center;
      valign: start;
      ellipsize: end;

      styles [
        "caption-heading",
      ]
    }

  }
}
