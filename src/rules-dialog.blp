using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog rules_dialog {
  content-width: 400;
  content-height: 400;
  title: _("Game Rules");
  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      Adw.ActionRow {
        title: C_("game rules", "Rotate and move pieces to fill rows, filled rows explode");

        [prefix]
        Image game_symbolic {}
      }
      Adw.ActionRow points_row {
        title: C_("game rules", "You gain points for each row destroyed");

        [prefix]
        Image {
          icon-name: "list-add-symbolic";
        }
      }
      Adw.ActionRow {
        title: C_("game rules", "When the game is paused, the next piece and the game view will be hidden");

        [prefix]
        Image {
          icon-name: "media-playback-pause-symbolic";
        }
      }
    }
  }
}

Grid points_info {
  hexpand: true;
  row-spacing: 6;

  Label {
    label: _("Rows Destroyed");
    halign: start;

    styles [ "dim-label", "heading" ]

    layout {
      row: 0;
      column: 0;
    }
  }

  Label {
    label: C_("points calculation", "Equation");
    halign: end;
    hexpand: true;

    styles [ "heading" ]

    layout {
      row: 0;
      column: 1;
    }
  }

  Label {
    label: "1";
    halign: start;

    styles [ "dim-label" ]

    layout {
      row: 1;
      column: 0;
    }
  }

  Label {
    label: "2";
    halign: start;

    styles [ "dim-label" ]

    layout {
      row: 2;
      column: 0;
    }
  }

  Label {
    label: "3";
    halign: start;

    styles [ "dim-label" ]

    layout {
      row: 3;
      column: 0;
    }
  }

  Label {
    label: "4";
    halign: start;

    styles [ "dim-label" ]

    layout {
      row: 4;
      column: 0;
    }
  }

  Label {
    label: C_("points calculation", "40 × level");
    halign: end;
    hexpand: true;

    layout {
      row: 1;
      column: 1;
    }
  }

  Label {
    label: C_("points calculation", "100 × level");
    halign: end;
    hexpand: true;

    layout {
      row: 2;
      column: 1;
    }
  }

  Label {
    label: C_("points calculation", "300 × level");
    halign: end;
    hexpand: true;

    layout {
      row: 3;
      column: 1;
    }
  }

  Label {
    label: C_("points calculation", "1200 × level");
    halign: end;
    hexpand: true;

    layout {
      row: 4;
      column: 1;
    }
  }

  Label {
    label: C_("game rules", "A bonus of <i>100 × level × rows destroyed</i> is applied if the bottom row is destroyed.");
    halign: start;
    margin-top: 12;
    use-markup: true;
    wrap: true;
    max-width-chars: 35;

    layout {
      row: 5;
      column: 0;
      column-span: 2;
    }
  }
}
